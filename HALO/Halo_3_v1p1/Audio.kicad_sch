  (text "Codec:\nI2C Addr: 0x1A\nVddMIC: 1.8V-3.6V\nVddA: 1.6V-2.65V\nVddIO: 1.5V-3.6V"
    (at 129.54 48.26 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid a0a00883-4e16-4770-8b99-52678bdbdd24)
  )
  (text "Capless true-ground\n** Layout Notes ** \nRoute L & R symmetrically around HPGND"
    (at 217.17 106.68 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid a1a724b8-8499-474f-8505-7bbe3d3298c8)
  )
  (text "I2C PU on MCU side\n" (at 88.9 124.46 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid b6cb3bad-9b05-48be-9b1b-09d97f0eeb18)
  )
  (text "Mic Bias = 1.6V\nZ= 0.8k - 1.6k; Rbias = 1.8k\nIbias  = 0.4705 mA - 0.6154 mA\nImax < 1mA\nRefer Section 13.3"
    (at 198.12 60.96 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid c782ddc6-df4e-48ef-b505-e322d5d2aff6)
  )
  (text "Z_MicIn = 15k;\nC = 0.22uF => fc = 50Hz\nSE (DNP C17) else DE\nRefer Section:B.1\n** Layout Notes ** \nRoute MIC & MICGND symmetrically as diff pair"
    (at 228.6 90.17 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid cda97daf-a885-4191-b292-836312a0dff2)
  )
