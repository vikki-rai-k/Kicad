	(text "VBAT: 3V-4.2V\nVBAT_MON: VBAT/6.1= 0.491 - 0.688"
		(exclude_from_sim no)
		(at 243.84 93.98 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "0409a0f3-95d0-4267-bd39-c75d8ccabc38")
	)
	(text "Flow of IBAT\nCharging: 0.8A from VBAT- to GND; VBAT- = 8mV\nNormal Mode: 0.3A from GND to VBAT-; VBAT- = -3mV\nVBAT- = -3m to +8mV\nA = 50; VoutCM = 0.49V\nIBAT_MON = VoutCM - A*(GND-VBAT-)\nIBAT_MON = 90mV(0.8A charging) to 640mV(0.3A discharging)\n\nVCM and Gain changed to accomodate RTL8763ESE ADC specs"
		(exclude_from_sim no)
		(at 187.96 43.18 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "1dabcd8f-1d2e-4ec6-a8dc-85aa85c9193f")
	)
